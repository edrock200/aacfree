{
  "name": "caleb-aac",
  "private": true,
  "version": "0.5.5",
  "description": "Caleb — a free, open-source AAC (augmentative & alternative communication) app for autistic people and their families.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-vision.mjs && tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "symbols": "node scripts/fetch-symbols.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease && cp app/build/outputs/apk/release/app-release.apk ../release/caleb-latest.apk",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "icons": "node scripts/make-icons.mjs",
    "e2e": "node scripts/e2e/flows.mjs",
    "screens": "node scripts/e2e/screens.mjs",
    "vision": "node scripts/copy-vision.mjs",
    "predev": "node scripts/copy-vision.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@mediapipe/tasks-vision": "^0.10.21",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
